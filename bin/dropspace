#!/usr/bin/env bash
# DropSpace CLI control utility
CONFIG="$HOME/.config/omarchy/dropspace.json"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

ensure_config() {
    if [ ! -f "$CONFIG" ]; then
        mkdir -p "$HOME/.config/omarchy"
        echo '{"top_edge_threshold": 12, "cancel_threshold": 180}' > "$CONFIG"
    fi
}

cmd_status() {
    ensure_config
    echo "=== DropSpace Status ==="
    
    # Check process
    if pgrep -fa "edge-watcher.py" >/dev/null 2>&1; then
        echo "Top-Edge Daemon (edge-watcher): RUNNING (PID: $(pgrep -fa "edge-watcher.py" | awk '{print $1}'))"
    else
        echo "Top-Edge Daemon (edge-watcher): NOT RUNNING (SUPER+D keybind mode only)"
    fi

    # Check UI state
    UI_STATE=$(omarchy-shell dropspace state 2>/dev/null || echo "unknown")
    echo "DropSpace UI State            : $UI_STATE"
    echo "Configuration file            : $CONFIG"
}

cmd_enable() {
    ensure_config
    # Start process if not running
    if ! pgrep -fa "edge-watcher.py" >/dev/null 2>&1; then
        nohup /usr/bin/env python3 "$SCRIPT_DIR/edge-watcher.py" >/dev/null 2>&1 &
        echo "Started edge-watcher daemon in background."
    else
        echo "edge-watcher daemon is already running."
    fi
}

cmd_disable() {
    # Stop process
    if pgrep -fa "edge-watcher.py" >/dev/null 2>&1; then
        pkill -f "edge-watcher.py" >/dev/null 2>&1 || true
        for _ in {1..20}; do
            pgrep -fa "edge-watcher.py" >/dev/null 2>&1 || break
            sleep 0.05
        done
        echo "Stopped edge-watcher daemon."
    else
        echo "edge-watcher daemon is not running."
    fi
}

cmd_setup() {
    ensure_config
    echo "=== DropSpace Setup ==="
    mkdir -p "$HOME/.local/bin"
    local bin_target="$HOME/.local/bin/dropspace"
    if [ -L "$bin_target" ] && [ "$(readlink -f "$bin_target")" = "$SCRIPT_DIR/dropspace" ]; then
        echo "✓ CLI symlink: Already active at $bin_target"
    else
        ln -sf "$SCRIPT_DIR/dropspace" "$bin_target"
        echo "✓ CLI symlink: Created $bin_target -> $SCRIPT_DIR/dropspace"
    fi

    echo "✓ Configuration initialized: $CONFIG"
    echo ""
    echo "Hyprland Configuration Guide:"
    echo "1. Keybindings (in ~/.config/hypr/bindings.lua):"
    echo '   local dropspace_handler = (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/dropspace/bin/drop-handler.sh"'
    echo '   o.bind("SUPER + d", "DropSpace: Toggle workspace targets", "omarchy-shell shell toggle dropspace '\''{}'\''")'
    echo '   o.bind("SUPER + mouse:272", "DropSpace: Drop window to workspace", dropspace_handler, { mouse = true, release = true })'
    echo ""
    echo "2. Optional Top Edge Autostart (in ~/.config/hypr/autostart.lua):"
    echo '   local dropspace_autostart = (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/dropspace/bin/dropspace-autostart.sh"'
    echo '   hl.exec_cmd(dropspace_autostart)'
    echo ""
    echo "DropSpace setup complete!"
}

cmd_uninstall() {
    echo "=== DropSpace Safe Uninstall Helper ==="
    
    # 1. Terminate daemon processes
    if pgrep -fa "edge-watcher.py" >/dev/null 2>&1; then
        pkill -f "edge-watcher.py" >/dev/null 2>&1 || true
        echo "✓ Stopped running edge-watcher daemon."
    fi

    # 2. Remove temporary files
    rm -f /tmp/dropspace_is_open /tmp/dropspace.log
    echo "✓ Cleaned temporary runtime files."

    # 3. Remove symlink if pointing to dropspace
    local bin_target="$HOME/.local/bin/dropspace"
    if [ -L "$bin_target" ]; then
        local link_dest
        link_dest="$(readlink -f "$bin_target" 2>/dev/null || true)"
        if [[ "$link_dest" == *"/dropspace"* ]]; then
            rm -f "$bin_target"
            echo "✓ Removed CLI symlink: $bin_target"
        fi
    fi

    # 4. Handle runtime configuration
    if [ -f "$CONFIG" ]; then
        if [[ "${1:-}" == "--purge" ]]; then
            rm -f "$CONFIG"
            echo "✓ Purged configuration file: $CONFIG"
        else
            echo "ℹ Configuration retained at: $CONFIG (pass --purge to delete)"
        fi
    fi

    echo ""
    echo "Next Steps to complete removal:"
    echo "1. If configured, remove the DropSpace lines from ~/.config/hypr/bindings.lua"
    echo "2. If configured, remove the DropSpace line from ~/.config/hypr/autostart.lua"
    echo "3. Remove the plugin from Omarchy shell:"
    echo "     omarchy plugin remove dropspace"
    echo "4. Reload Hyprland configuration:"
    echo "     hyprctl reload"
}

case "$1" in
    status)
        cmd_status
        ;;
    setup)
        cmd_setup
        ;;
    uninstall|cleanup)
        shift
        cmd_uninstall "$@"
        ;;
    edge-watcher)
        case "$2" in
            enable)
                cmd_enable
                ;;
            disable)
                cmd_disable
                ;;
            status)
                cmd_status
                ;;
            *)
                echo "Usage: dropspace edge-watcher {enable|disable|status}"
                exit 1
                ;;
        esac
        ;;
    show)
        omarchy-shell shell summon dropspace '{}'
        ;;
    hide)
        omarchy-shell shell hide dropspace
        ;;
    toggle)
        omarchy-shell shell toggle dropspace '{}'
        ;;
    *)
        echo "DropSpace - Omarchy Workspace Drag & Drop Tool"
        echo ""
        echo "Usage:"
        echo "  dropspace status                 Check current status and configuration"
        echo "  dropspace setup                  Set up CLI symlink and show binding setup"
        echo "  dropspace uninstall [--purge]    Stop daemons and clean up files before plugin removal"
        echo "  dropspace edge-watcher enable    Enable top-edge auto detection"
        echo "  dropspace edge-watcher disable   Disable top-edge auto detection (pure SUPER+D mode)"
        echo "  dropspace toggle                 Toggle workspace drop bar UI"
        echo "  dropspace show                   Show workspace drop bar UI"
        echo "  dropspace hide                   Hide workspace drop bar UI"
        exit 0
        ;;
esac
